{
  "_comment": "没联网的示例，展示 sources/builtin/sources.json 的完整字段。不会被打包进 exe。需要内容限制的图源要写 filter.sfwQuery（例如 purity=100），写法见 sources/builtin/sources.json。",
  "schemaVersion": 1,
  "sources": [
    {
      "id": "example",
      "name": "示例图源（不可用）",
      "enabled": false,
      "homepage": "https://example.invalid/",
      "request": {
        "url": "https://example.invalid/api/posts?limit={limit}&page={page}",
        "method": "GET",
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "itemsPath": "data",
        "imageUrl": "file_url",
        "thumbnailUrl": "sample_url",
        "pageUrl": "post_url"
      }
    }
  ]
}
