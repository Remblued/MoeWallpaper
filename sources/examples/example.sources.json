{
  "_comment": "这是一个没有联网的示例，展示 sources/builtin/sources.json 的完整字段。它不会被打包进 exe，只作为写新图源时的模板。",
  "schemaVersion": 1,
  "sources": [
    {
      "id": "example",
      "name": "示例图源（不可用）",
      "enabled": false,
      "homepage": "https://example.invalid/",
      "request": {
        "url": "https://example.invalid/api/posts?limit={limit}&page={page}",
        "method": "GET",
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "itemsPath": "data",
        "imageUrl": "file_url",
        "thumbnailUrl": "sample_url",
        "pageUrl": "post_url"
      },
      "filter": {
        "sfwOnly": true
      }
    }
  ]
}
