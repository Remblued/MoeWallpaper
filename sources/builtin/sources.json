{
  "schemaVersion": 1,
  "sources": [
    {
      "id": "360",
      "name": "360 壁纸 · 动漫卡通",
      "enabled": true,
      "homepage": "http://wallpaper.360.cn/",
      "request": {
        "url": "http://wallpaper.apc.360.cn/index.php?c=WallPaper&a=getAppsByCategory&from=360chrome&cid=26&start={offset}&count={limit}",
        "method": "GET",
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "itemsPath": "data",
        "imageUrl": "url",
        "thumbnailUrl": "url_thumb",
        "resolution": "resolution",
        "tags": "utag"
      },
      "filter": {
        "httpsUpgrade": true,
        "randomOffsetMax": 8000
      }
    },
    {
      "id": "safebooru",
      "name": "Safebooru · 动漫插画",
      "enabled": true,
      "homepage": "https://safebooru.org/",
      "request": {
        "url": "https://safebooru.org/index.php?page=dapi&s=post&q=index&json=1&limit={limit}&pid={pageIndex}&tags=rating:general+width:>=1920",
        "method": "GET",
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "imageUrl": "file_url",
        "thumbnailUrl": "preview_url",
        "width": "width",
        "height": "height"
      },
      "filter": {
        "randomPageIndexMax": 8000
      },
      "search": {
        "url": "https://safebooru.org/index.php?page=dapi&s=post&q=index&json=1&limit={limit}&pid={pageIndex}&tags=rating:general+{query}",
        "english": true,
        "underscoreTags": true
      }
    },
    {
      "id": "wallhaven",
      "name": "Wallhaven · 动漫",
      "enabled": true,
      "homepage": "https://wallhaven.cc/",
      "request": {
        "url": "https://wallhaven.cc/api/v1/search?categories=010&sorting=random&page={page}",
        "method": "GET",
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "itemsPath": "data",
        "imageUrl": "path",
        "thumbnailUrl": "thumbs.large",
        "pageUrl": "url",
        "width": "dimension_x",
        "height": "dimension_y"
      },
      "filter": {
        "sfwQuery": "purity=100"
      },
      "search": {
        "url": "https://wallhaven.cc/api/v1/search?categories=010&q={query}&page={page}",
        "english": true
      }
    },
    {
      "id": "nekos-best",
      "name": "nekos.best · 二次元",
      "enabled": true,
      "homepage": "https://nekos.best/",
      "request": {
        "url": "https://nekos.best/api/v2/neko?amount={limit}",
        "method": "GET",
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "itemsPath": "results",
        "imageUrl": "url",
        "pageUrl": "source_url",
        "width": "dimensions.width",
        "height": "dimensions.height"
      }
    },
    {
      "id": "lolicon",
      "name": "Lolicon · Pixiv",
      "enabled": true,
      "homepage": "https://api.lolicon.app/",
      "contentNote": "尺度较大",
      "request": {
        "url": "https://api.lolicon.app/setu/v2?num={limit}&p={page}&proxy=i.pixiv.re",
        "method": "GET",
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "itemsPath": "data",
        "imageUrl": "urls.original",
        "width": "width",
        "height": "height"
      },
      "filter": {
        "sfwQuery": "r18=0"
      },
      "search": {
        "url": "https://api.lolicon.app/setu/v2?num={limit}&keyword={query}&p={page}&proxy=i.pixiv.re",
        "english": false
      }
    }
  ]
}
